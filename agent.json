  "repository": {
    "type": "git",
    "url": "https://github.com/Mesum-Hussain/botter.git"
  },
  "bugs": {
    "url": "https://github.com/Mesum-Hussain/botter/issues"
  },
  "engines": {
    "botcore": ">=0.1.0"
  },
  "requires": [
    "git"
  ],
